# ---------------------------------------------------------------------------
# RAG Reliability Service — biến môi trường
# Copy sang .env rồi điền giá trị. File .env bị git bỏ qua. Không commit key thật.
# ---------------------------------------------------------------------------

# ---- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=log
SWAGGER_ENABLED=true

# ---- Database ---------------------------------------------------------
# Khớp với docker-compose. Dùng localhost khi chạy app ngoài Docker.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_reliability?schema=public

# ---- Queue xử lý tài liệu (BullMQ + Redis) ---------------------------
# BẬT (mặc định): POST /documents trả 202 + jobId ngay, worker BullMQ chạy
# pipeline ingest→chunk→embed→graph nền. Theo dõi qua GET /documents/:id
# (field `status` + `jobState`). Cần Redis: `docker compose up -d redis`.
# TẮT: chạy inline đồng bộ trong request (test/CI/không Redis).
QUEUE_ENABLED=true
# Trong compose network Redis là "redis"; ngoài Docker dùng 127.0.0.1.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
# Số job document chạy song song. Giữ 1 để không nghẽn LLM local (Ollama tuần tự).
QUEUE_CONCURRENCY=1
# Số lần chạy tối đa một job khi lỗi (retry = attempts - 1), backoff mũ.
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=5000

# ---- Chọn provider LLM / Embedding ---------------------------------------
# openai | gemini | anthropic | custom | fake
#   fake = tất định (deterministic), CHỈ CI/dev — chạy được RAG pipeline
#   (retrieve → context → generate) mà không cần API key thật.
LLM_PROVIDER=openai
# openai | gemini | custom | fake
EMBEDDING_PROVIDER=openai

# ---- Rate limiting (@nestjs/throttler) --------------------------------
# Đặt false nếu deploy sau API gateway đã lo throttling.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
# Trần chặt hơn cho /rag/query & /rag/search (mỗi request gọi nhiều LLM):
RATE_LIMIT_RAG_LIMIT=20

# ---- OpenAI ---------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Google Gemini -----------------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---- Anthropic --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# ---- Custom provider (API tương thích OpenAI) ---------------------------
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_EMBEDDING_BASE_URL=
CUSTOM_EMBEDDING_API_KEY=
CUSTOM_EMBEDDING_MODEL=

# ---- Embedding -------------------------------------------------------
# EMBEDDING_PROVIDER (phần trên): openai | gemini | custom | fake
#   fake = tất định theo hash nội dung, chỉ cho CI/dev, không cần API key
# EMBEDDING_DIMENSION phải khớp số chiều output của model:
#   intfloat/multilingual-e5-large = 1024 (mặc định, self-hosted, đa ngôn ngữ)
#   OpenAI text-embedding-3-small = 1536, Gemini text-embedding-004 = 768
#   Đổi giá trị này cần migration mới cho cột vector (xem prisma/migrations).
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=96
# cosine (chuẩn cho embedding đã normalize) | l2 | ip — phải khớp index HNSW
EMBEDDING_DISTANCE=cosine
# Tiền tố bất đối xứng cho model họ E5/GTE. Để trống -> tự suy ra khi tên model
# chứa "e5". intfloat/multilingual-e5-large BẮT BUỘC:
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
# Gợi ý chạy e5-large self-hosted (TEI / vLLM / Ollama qua API OpenAI-compatible):
#   EMBEDDING_PROVIDER=custom
#   CUSTOM_EMBEDDING_BASE_URL=http://localhost:8080/v1
#   CUSTOM_EMBEDDING_MODEL=zylonai/multilingual-e5-large

# Document ingestion mồ côi cũ hơn ngưỡng này (ms) được thu hồi để cho phép nạp
# lại (mặc định 15 phút). Xem DocumentDeduplicatorService.
# INGESTION_STALE_AFTER_MS=900000

# ---- Parsing tài liệu (anydoc) -----------------------------------------
# Tuỳ chọn: chỉ cần khi dùng OCR hosted cho PDF scan.
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=
# reject | hosted
ANYDOC_OCR=reject

# ---- Chunking -------------------------------------------------------
# structure = Markdown-aware (từ anydoc) | fixed = cửa sổ token cố định (baseline)
# semantic = cắt tại ranh giới ngữ nghĩa (embedding câu liền kề; cần provider embedding)
CHUNKING_STRATEGY=structure
# SEMANTIC_BREAKPOINT_PERCENTILE=90
# SEMANTIC_BUFFER_SIZE=1
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=64
CHUNK_OVERLAP_TOKENS=64

# ---- Cấu hình RAG ---------------------------------------------------
QUALITY_THRESHOLD=0.7
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=4000

# ---- Reranking (PHASE 7) --------------------------------------------
# Tắt → retrieval(topK=RERANK_TOP_K) đi thẳng vào context. Bật → kéo
# RERANK_CANDIDATES ứng viên rồi rerank về RERANK_TOP_K.
RERANK_ENABLED=false
# none = identity (baseline/fallback) | fake = heuristic token-overlap (CI) |
# llm = listwise LLM chấm 0-10 (1 lời gọi). Lỗi provider → fallback identity (§54).
RERANK_PROVIDER=none
RERANK_CANDIDATES=20

# ---- RAG query (PHASE 4) ----------------------------------------------
# Ngưỡng để KHÔNG abstain. Mặc định 0 / 1 → baseline chỉ abstain khi 0 chunk
# (giữ hallucination đo được — §35).
RAG_MIN_RELEVANCE=0
RAG_MIN_CHUNKS=1
# Nhiệt độ generation (0 = tất định nhất, phù hợp grounded answer)
RAG_TEMPERATURE=0

# ---- Grounded generation + abstention (PHASE 8) ---------------------
# TẮT = baseline P4 (giữ hallucination đo được). BẬT = siết ngưỡng relevance +
# hậu kiểm answer↔context + CONFLICTING_EVIDENCE + sinh lại 1 lần.
# Ghi đè per-request: POST /rag/query { "strict": true }.
RAG_STRICT_GROUNDING=false
# Khi strict: abstain nếu điểm relevance cao nhất < ngưỡng này.
# LƯU Ý thang điểm: mặc định 0.15 hợp cho pipeline CÓ RERANK (rerankScore ~0.0+).
# Vector-only cosine cho chunk trực giao ≈ 0.5 → chạy vector-only + strict phải
# nâng lên ~0.65 (xem docs/rag/grounding.md).
RAG_ABSTAIN_MIN_RELEVANCE=0.15
# Khi strict: answer >= 5 token nội dung mà tỉ lệ trùng token với context < ngưỡng
# → hạ status (câu ngắn hơn được bỏ qua vì ratio nhiễu).
RAG_MIN_GROUNDING_RATIO=0.4
# Khi strict + câu trả lời đầu không bám ngữ cảnh: sinh lại 1 lần.
RAG_REGENERATE_ON_UNGROUNDED=true

# ---- Citation cấp claim (PHASE 9) ----------------------------------
# TẮT = hành vi P4 (map thô theo usedContext). BẬT = tách claim + đối chiếu
# evidence + citation do backend cấp id.
RAG_CITATION_ENABLED=true
# Gộp bước tách claim vào chính lời gọi generation (bỏ 1 lời gọi LLM —
# docs/audit/ARCHITECTURE_REVIEW.md §5.3). TẮT = luôn gọi ClaimExtractor riêng.
RAG_CONSOLIDATE_CLAIMS=true
# Tỉ lệ token nội dung của claim phải có trong chunk để coi là được hỗ trợ.
CITATION_MIN_OVERLAP=0.5
CITATION_MAX_PER_CLAIM=3
# Thử map claim quan hệ → cạnh RELATED trong Neo4j (no-op nếu graph tắt).
CITATION_RELATIONSHIP_ENABLED=true
# Answer ngắn hơn ngưỡng token này coi như 1 claim = chính nó (khỏi gọi LLM).
CITATION_MIN_ANSWER_TOKENS=6

# ---- Faithfulness Verifier & Contradiction (PHASE 10) --------------
RAG_FAITHFULNESS_ENABLED=true
# auto = heuristic tìm ứng viên, LLM NLI xác nhận mâu thuẫn | heuristic | llm
FAITHFULNESS_VERIFIER_MODE=auto
RAG_REGENERATE_ON_UNFAITHFUL=true

# ---- Ngưỡng độ tin cậy -------------------------------------------
FAITHFULNESS_THRESHOLD=0.8
HALLUCINATION_THRESHOLD=0.1

# ---- An toàn khi gọi AI API ------------------------------------
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=500

# ---- Graph RAG (PHASE 5) --------------------------------------------
# Bật/tắt Graph RAG. Khi GRAPH_RAG_ENABLED=true => NEO4J_URI và NEO4J_PASSWORD bắt buộc.
GRAPH_RAG_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_MAX_POOL_SIZE=50
NEO4J_QUERY_TIMEOUT_MS=15000

# Extraction thực thể & quan hệ từ chunk (P5)
GRAPH_EXTRACT_MAX_TOKENS=3000
GRAPH_EXTRACT_GLEANINGS=1
GRAPH_EXTRACT_MAX_LLM_CALLS_PER_DOC=40
GRAPH_ENTITY_TYPES=PERSON,ORG,LOCATION,DATE,REGULATION,CONCEPT,EVENT,PRODUCT
GRAPH_PROMPT_VERSION=1
# Model riêng cho bước trích xuất graph (gửi tới CUSTOM_LLM_BASE_URL). Để trống
# → dùng model chính. Nên đặt model KHÔNG-reasoning: model "thinking" (qwen3...)
# sinh khối <think> rất dài cho structured output ⇒ mỗi lời gọi vài phút.
# Đổi giá trị này ⇒ khoá cache extraction đổi ⇒ chunk cũ được trích lại.
# GRAPH_EXTRACT_MODEL=qwen2.5:7b

# ---- Retrieval nâng cao (PHASE 6) ---------------------------------------
# Chiến lược mặc định; ghi đè per-request bằng field `strategy` trong body
# POST /rag/query|search. hybrid = vector + keyword + graph rồi fusion.
RETRIEVAL_STRATEGY=vector

# Graph traversal & entity linking
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITY_DEGREE=200
GRAPH_RETRIEVAL_TOP_K=10
# Tầng 3 entity linking: rút thực thể từ query bằng LLM khi tầng 1 rỗng
GRAPH_LINK_USE_LLM=true

# Fusion (hợp nhất khi strategy=hybrid)
# rrf = Reciprocal Rank Fusion (bền, không cần score cùng thang) | weighted
FUSION_METHOD=rrf
FUSION_RRF_K=60
FUSION_WEIGHT_VECTOR=1.0
FUSION_WEIGHT_KEYWORD=0.7
FUSION_WEIGHT_GRAPH=0.8

