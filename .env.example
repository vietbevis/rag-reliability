# ---------------------------------------------------------------------------
# RAG Reliability Service — biến môi trường
# Copy sang .env rồi điền giá trị. File .env bị git bỏ qua. Không commit key thật.
# ---------------------------------------------------------------------------

# ---- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=log
SWAGGER_ENABLED=true

# ---- Database ---------------------------------------------------------
# Khớp với docker-compose. Dùng localhost khi chạy app ngoài Docker.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_reliability?schema=public

# ---- Chọn provider LLM / Embedding ---------------------------------------
# openai | gemini | anthropic | custom
LLM_PROVIDER=openai
# openai | gemini | custom
EMBEDDING_PROVIDER=openai

# ---- OpenAI ---------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Google Gemini -----------------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---- Anthropic --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# ---- Custom provider (API tương thích OpenAI) ---------------------------
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_EMBEDDING_BASE_URL=
CUSTOM_EMBEDDING_API_KEY=
CUSTOM_EMBEDDING_MODEL=

# ---- Embedding -------------------------------------------------------
# Phải khớp số chiều output của model embedding đang dùng:
#   OpenAI text-embedding-3-small = 1536, Gemini text-embedding-004 = 768
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=96

# ---- Parsing tài liệu (anydoc) -----------------------------------------
# Tuỳ chọn: chỉ cần khi dùng OCR hosted cho PDF scan.
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=
# reject | hosted
ANYDOC_OCR=reject

# ---- Chunking -------------------------------------------------------
# structure = Markdown-aware (từ anydoc) | fixed = cửa sổ token cố định (baseline)
CHUNKING_STRATEGY=structure
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=64
CHUNK_OVERLAP_TOKENS=64

# ---- Cấu hình RAG ---------------------------------------------------
QUALITY_THRESHOLD=0.7
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=4000

# ---- Ngưỡng độ tin cậy -------------------------------------------
FAITHFULNESS_THRESHOLD=0.8
HALLUCINATION_THRESHOLD=0.1

# ---- An toàn khi gọi AI API ------------------------------------
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=500
