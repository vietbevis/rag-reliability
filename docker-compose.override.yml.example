# cp sang docker-compose.override.yml để map port Neo4j Browser / Bolt ra máy host khi dev.
# File docker-compose.override.yml được git bỏ qua.
# Khởi động: docker compose --profile graph up -d

services:
  neo4j:
    ports:
      # Neo4j Browser UI (http://localhost:7474)
      - '7474:7474'
      # Bolt protocol
      - '7687:7687'
